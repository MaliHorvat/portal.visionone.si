# VisionOne portal — primer env spremenljivk
# Kopiraj v .env.local (lokalno) ali v Vercel → Settings → Environment Variables (produkcija).
# NE commitaj pravih ključev v git — samo placeholderji spodaj.

# --- Clerk (prijava pred portalom) ---
# Ustvarite aplikacijo na https://dashboard.clerk.com — Sign-in URL in Sign-up URL: /portal-login
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# V Clerk Dashboard → Paths: Sign-in in Sign-up URL naj bo https://vaša-domena/portal-login
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal-login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal-login

# --- Obvestilo na info@visionone.si ob zahtevku za portal (obvezno: SMTP ali Resend) ---
# Prejemnik (privzeto info@visionone.si):
PORTAL_ACCESS_NOTIFY_EMAIL=info@visionone.si
#
# Možnost A — SMTP (npr. poštni predal pri NEOSERV; navodila: neoserv.si → Podpora → e-pošta):
# Strežnik: običajno mail.vasadomena.si (za visionone.si → mail.visionone.si). Če SSL ne sprejme
# tega imena, v Moj NEOSERV preverite ime strežnika, na katerem gostuje paket.
# Z SSL: vrata 465 (v portalu nastavite PORTAL_SMTP_PORT=465 — nodemailer uporabi secure za 465).
# PORTAL_SMTP_HOST=mail.visionone.si
# PORTAL_SMTP_PORT=465
# PORTAL_SMTP_USER=info@visionone.si
# PORTAL_SMTP_PASS=geslo_predala_iz_cpanel
# PORTAL_SMTP_FROM=info@visionone.si
#
# Brez SSL (če 465 ne deluje): vrata 587 ali 26, vendar pri NEOSERV mora biti vključena SMTP avtentikacija (že jo pošljemo).
# PORTAL_SMTP_PORT=587
#
# Možnost B — Resend (https://resend.com, preverjena domena za FROM):
# RESEND_API_KEY=re_...
# PORTAL_RESEND_FROM=noreply@visionone.si

# --- PostgreSQL (Faza 1: Stranke / Paketi / Opomniki) ---
# Primer (Vercel Postgres / Neon / Supabase / lokalni):
# DATABASE_URL="postgresql://user:password@host:5432/visionone?sslmode=require"
DATABASE_URL=

# --- VisionOne VMS control plane ---
# Ločena MySQL baza za customer VMS aplikacijo. NE uporabljaj portal DATABASE_URL.
VMS_DATABASE_URL=
NEXT_PUBLIC_VMS_BASE_URL=https://vms.visionone.si

# --- Podpis portalne seje (vsaj 16 znakov). Obvezno na Vercelu / javnem strežniku. ---
# Za lokalni `next start` lahko preskočite; aplikacija uporabi začasni ključ (opozorilo v konzoli).
PORTAL_SESSION_SECRET=lokalni-zacetni-kljuc-vsaj-16-znakov

# --- Različica prikazana na nadzorni plošči (opcijsko) ---
# NEXT_PUBLIC_APP_VERSION="1.7.0"

# --- ESP telemetrija (agent -> portal) ---
# Agent pošilja Authorization: Bearer <ESP_INGEST_TOKEN>
ESP_INGEST_TOKEN=
