# VisionOne portal — primer env spremenljivk
# Kopiraj v .env.local (lokalno) ali v Vercel → Settings → Environment Variables (produkcija).
# NE commitaj pravih ključev v git — samo placeholderji spodaj.

# --- Clerk (prijava pred portalom) ---
# Ustvarite aplikacijo na https://dashboard.clerk.com — Sign-in URL in Sign-up URL: /portal-login
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# V Clerk Dashboard → Paths: Sign-in in Sign-up URL naj bo https://vaša-domena/portal-login
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal-login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal-login

# Opcijsko: e-poštno obvestilo skrbniku ob zahtevku za dostop (Resend + preverjen pošiljatelj)
# RESEND_API_KEY=
# PORTAL_RESEND_FROM=noreply@your-verified-domain.com
PORTAL_ACCESS_NOTIFY_EMAIL=info@visionone.si

# --- PostgreSQL (Faza 1: Stranke / Paketi / Opomniki) ---
# Primer (Vercel Postgres / Neon / Supabase / lokalni):
# DATABASE_URL="postgresql://user:password@host:5432/visionone?sslmode=require"
DATABASE_URL=

# --- Podpis portalne seje (vsaj 16 znakov). Obvezno na Vercelu / javnem strežniku. ---
# Za lokalni `next start` lahko preskočite; aplikacija uporabi začasni ključ (opozorilo v konzoli).
PORTAL_SESSION_SECRET=lokalni-zacetni-kljuc-vsaj-16-znakov

# --- Različica prikazana na nadzorni plošči (opcijsko) ---
# NEXT_PUBLIC_APP_VERSION="1.7.0"

# --- ESP telemetrija (agent -> portal) ---
# Agent pošilja Authorization: Bearer <ESP_INGEST_TOKEN>
ESP_INGEST_TOKEN=
