// VisionOne portal — podatkovni model (faza 1)
// Generator + datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(cuid())
  /** Berljiv segment URL-ja (/portal/stranke/[slug]); interni API ostane na id. */
  slug      String?  @unique
  name      String
  address   String   @default("")
  contact   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  ownerUsername String @default("admin")
  sortOrder Int @default(0)
  health    String   @default("ok")
  topologyData Json?
  rackData       Json?
  packageId String?
  package   SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  cameras   ClientCamera[]
  recorders ClientRecorder[]
  switches  ClientSwitch[]
  disks     ClientDisk[]
  reminders MaintenanceReminder[]
  serviceRequests ServiceRequest[]
  offers    ClientOffer[]
  siteSurveys ClientSiteSurvey[]
  timeLogs  ClientTimeLog[]
  telemetryAgents TelemetryAgent[]
  agentClaims AgentClaimCode[]
  agentJobs AgentJob[]
  deviceProbes DeviceProbe[]
  deviceChecks DeviceCheck[]
  documents ClientDocument[]
  fieldVisits FieldVisit[]
  profileNote ClientProfileNote?
  profileChanges ClientProfileChangeLog[]
  /** Oznake (niz nizov) — JSON polje, npr. ["VIP","teren"]. */
  tags      Json     @default("[]")
  /** VisionOne Care Box — monitoring + 24/7 podpora (brez VMS za stranko). */
  careBoxEnabled Boolean @default(false)
  /** SLA: standard | priority | critical (prazno = ni nastavljeno). */
  careSlaTier    String  @default("")
  careRemoteNotes String @db.Text @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([ownerUsername])
}

model ClientProfileNote {
  clientId  String   @id
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String   @db.Text @default("")
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt
}

model ClientProfileChangeLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String   @db.Text @default("")
  newValue  String   @db.Text @default("")
  username  String   @default("")
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientDocument {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /** Relativna "pot mape", npr. "Pogodbe" ali "Slike/hodnik" */
  folder       String   @default("")
  originalName String
  mimeType     String   @default("application/octet-stream")
  sizeBytes    Int      @default(0)
  data         Bytes    @db.LongBlob
  createdAt    DateTime @default(now())

  @@index([clientId, folder])
}

model ClientCamera {
  id       String  @id @default(cuid())
  clientId String
  name     String
  ip       String  @default("")
  model    String  @default("")
  status   String  @default("online")
  checkPort Int?
  rtspUser  String @default("")
  rtspPass  String @default("")
  streamUrl String @default("")
  comment   String @default("")
  tag       String @default("")
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientRecorder {
  id       String  @id @default(cuid())
  clientId String
  name     String
  ip       String  @default("")
  model    String  @default("")
  status   String  @default("online")
  diskTb   Float   @default(0)
  comment  String  @default("")
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientSwitch {
  id       String  @id @default(cuid())
  clientId String
  name     String
  ip       String  @default("")
  model    String  @default("")
  status   String  @default("online")
  ports    Int     @default(0)
  comment  String  @default("")
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientDisk {
  id          String  @id @default(cuid())
  clientId    String
  label       String
  ip          String  @default("")
  model       String  @default("")
  sizeTb      Float   @default(0)
  installedAt String  @default("")
  health      String  @default("ok")
  serial      String  @default("")
  comment     String  @default("")
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientOffer {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title            String   @default("")
  offerDate        String   @default("")
  clientAddress    String   @default("")
  notes            String   @db.Text @default("")
  totalDiscountPct Float    @default(0)
  vatEnabled       Boolean  @default(true)
  vatPct           Float    @default(22)
  /** Številka dokumenta, npr. PON-2026-0001 */
  offerNumber      String   @default("")
  /** draft | sent | accepted | rejected */
  offerStatus      String   @default("draft")
  lines            ClientOfferLine[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clientId])
  @@index([offerNumber])
}

model OfferTemplate {
  id              String   @id @default(cuid())
  ownerUsername   String   @default("admin")
  name            String
  /** JSON: niz postavk { section, code, description, unit, qty, unitPrice, discountPct, lineVatPct } */
  lines           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerUsername])
}

model ClientOfferLine {
  id          String      @id @default(cuid())
  offerId     String
  offer       ClientOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  section     String      @default("material")
  sortOrder   Int         @default(0)
  code        String      @default("")
  description String      @default("")
  unit        String      @default("kos")
  qty         Float       @default(1)
  unitPrice   Float       @default(0)
  discountPct Float       @default(0)
  lineVatPct  Float       @default(22)

  @@index([offerId])
}

model ClientSiteSurvey {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  surveyDate    String   @default("")
  objectType    String   @default("")
  address       String   @default("")
  ceilingHeight String   @default("")
  cabling       String   @default("")
  powerSupply   String   @default("")
  lighting      String   @default("")
  notes         String   @db.Text @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

model ClientTimeLog {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workDate     String   @default("")
  technician   String   @default("")
  note         String   @db.Text @default("")
  /** Pri ročnem vnosu npr. „10:00–12:00“; prazno če timer ali samo decimalne ure. */
  timeRangeLabel String @default("")
  startedAt    DateTime?
  endedAt      DateTime?
  hours        Float    @default(0)
  hourlyRate   Float    @default(0)
  costComputed Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId])
}

model SubscriptionPackage {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float    @default(0)
  description String   @default("")
  clients     Client[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MaintenanceReminder {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  dueDate   String
  kind      String   @default("drugo")
  completed Boolean  @default(false)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  ownerUsername String               @default("admin")
  clientId      String?
  client        Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title         String
  description   String               @db.Text @default("")
  status        ServiceRequestStatus @default(new)
  priority      ServiceRequestPriority @default(medium)
  dueDate       String               @default("")
  createdBy     String               @default("portal")
  assignee      String               @default("")
  attachments   ServiceRequestAttachment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([ownerUsername, status, priority])
  @@index([clientId])
}

model ServiceRequestAttachment {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  originalName     String
  mimeType         String         @default("application/octet-stream")
  sizeBytes        Int            @default(0)
  data             Bytes          @db.LongBlob
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
}

model PortalIpamEntry {
  id              String   @id @default(cuid())
  ownerUsername   String   @default("admin")
  ip              String
  name            String   @default("")
  mac             String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ownerUsername, ip])
}

model TelegramNotificationRule {
  id       String      @id @default(cuid())
  botId    String
  bot      TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  eventKey String
  enabled  Boolean     @default(true)

  @@unique([botId, eventKey])
}

model FieldVisit {
  id             String   @id @default(cuid())
  ownerUsername  String   @default("admin")
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  checkedInBy    String   @default("portal")
  checkInAt      DateTime @default(now())
  checkOutAt     DateTime?
  checklist      Json?
  photoProofs    Json?
  signatureDataUrl String @db.LongText @default("")
  reportText     String   @db.Text @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerUsername, checkInAt])
  @@index([clientId, checkInAt])
}

model TelemetryAgent {
  id         String        @id @default(cuid())
  externalId String        @unique
  name       String
  siteLabel  String        @default("")
  clientId   String?
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lastSeenAt DateTime?
  configVersion Int        @default(1)
  lastConfigAt DateTime?
  lastError   String       @default("")
  /** standard | care_box */
  agentKind   String       @default("standard")
  devices    DeviceProbe[]
  checks     DeviceCheck[]
  jobs       AgentJob[]
  claims     AgentClaimCode[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([clientId])
}

model AgentClaimCode {
  id          String   @id @default(cuid())
  code        String   @unique
  externalId  String
  name        String
  siteLabel   String   @default("")
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       TelemetryAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdBy   String   @default("admin")
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([externalId])
  @@index([expiresAt])
}

model AgentJob {
  id          String        @id @default(cuid())
  agentId     String
  agent       TelemetryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type        AgentJobType
  status      AgentJobStatus @default(pending)
  payload     Json
  result      Json?
  errorText   String        @default("")
  createdBy   String        @default("admin")
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([agentId, status, createdAt])
  @@index([clientId, createdAt])
}

model DeviceProbe {
  id          String        @id @default(cuid())
  agentId     String
  agent       TelemetryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deviceKey   String
  name        String
  ip          String
  kind        String
  status      String        @default("offline")
  latencyMs   Int?
  lastError   String        @default("")
  lastSeenAt  DateTime?
  checks      DeviceCheck[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([agentId, deviceKey])
  @@index([agentId])
  @@index([clientId])
  @@index([status])
}

model DeviceCheck {
  id          String         @id @default(cuid())
  agentId     String
  agent       TelemetryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deviceId    String?
  device      DeviceProbe?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceKey   String
  status      String
  latencyMs   Int?
  errorText   String         @default("")
  checkedAt   DateTime
  createdAt   DateTime       @default(now())

  @@index([agentId, checkedAt])
  @@index([clientId, checkedAt])
  @@index([deviceId, checkedAt])
}

model CameraDefinition {
  manufacturer String @id
  mainStream   String @default("")
  subStream    String @default("")
}

model TelegramBot {
  id     String @id @default(cuid())
  name   String
  token  String @db.Text
  chatId String
  rules  TelegramNotificationRule[]
}

model UserNote {
  id        Int      @id @default(autoincrement())
  username  String   @default("portal")
  parentId  Int?
  title     String
  content   String   @db.Text
  isFolder  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  username  String   @default("")
  action    String
  details   String   @db.Text

  @@index([createdAt])
}

model SavedView {
  id        Int      @id @default(autoincrement())
  name      String
  layout    Json
  createdAt DateTime @default(now())
}

/** Samostojni rack projekt (globalni Rack dizajner — ni vezan na stranko). */
model StandaloneRack {
  id        String   @id @default(cuid())
  name      String   @default("Rack")
  rackData  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppUserAccount {
  id           String @id @default(cuid())
  username     String @unique
  email        String @default("")
  passwordHash String
  role         PortalUserRole @default(viewer)
  isAdmin      Boolean @default(false)
  mustChangePassword Boolean @default(true)
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  navPermissions     Json?
  accessRequests     PortalAccessRequest[]
}

model PasswordResetRequest {
  username String @id
  status   String @default("requested")
}

enum PortalUserRole {
  admin
  operator
  viewer
}

enum AgentJobType {
  ping
  scan
}

enum AgentJobStatus {
  pending
  running
  done
  error
}

enum PortalAccessRequestStatus {
  new
  approved
  rejected
}

enum ServiceRequestStatus {
  new
  in_progress
  waiting_customer
  done
}

enum ServiceRequestPriority {
  low
  medium
  high
  urgent
}

model PortalAccessRequest {
  id            String                    @id @default(cuid())
  clerkUserId   String                    @unique
  clerkEmail    String                    @default("")
  clerkName     String                    @default("")
  status        PortalAccessRequestStatus @default(new)
  requestedAt   DateTime                  @default(now())
  processedAt   DateTime?
  processedBy   String                    @default("")
  note          String                    @db.Text @default("")
  portalUserId  String?
  portalUser    AppUserAccount?           @relation(fields: [portalUserId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([portalUserId])
}
