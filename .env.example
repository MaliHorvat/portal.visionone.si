# VisionOne Field (portal.visionone.si)
# Vercel → Project → Settings → Environment Variables

# MySQL/MariaDB – ista baza kot prejšnji portal (stranke se ob prvem zagonu uvozijo samodejno)
DATABASE_URL=mysql://uporabnik:geslo@gostitelj:3306/baza

# Ključ za šifriranje gesel naprav in podpis prijave (openssl rand -hex 32). NE spreminjajte ga kasneje.
SECRET_KEY=

# Začetni skrbnik (ustvari se samo, če v bazi še ni uporabnikov)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Neobvezno
# DB_CONNECTION_LIMIT=3
# TZ=Europe/Ljubljana
